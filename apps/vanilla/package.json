{
  "name": "@flow/vanilla",
  "version": "0.0.0",
  "private": true,
  "homepage": "https://bearing-ward.github.io/flow/",
  "files": [
    "dist/public.js",
    "dist/*.d.ts",
    "dist/ui/*.d.ts",
    "dist/style.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/public.d.ts",
      "import": "./dist/public.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "build:package": "bun build src/public.ts --outfile dist/public.js --target browser --format esm --external effect --external @flow/core && bun build src/style.css --outfile dist/style.css && tsc --project tsconfig.build.json",
    "dev": "vite --host 127.0.0.1 --port 4173",
    "build": "vite build"
  },
  "dependencies": {
    "@flow/core": "workspace:*",
    "effect": "4.0.0"
  },
  "devDependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@flow/layout": "workspace:*",
    "@types/d3-force": "3.0.10",
    "d3-force": "3.0.0",
    "elkjs": "0.12.0",
    "html-to-image": "1.11.13",
    "vite": "8.3.5"
  }
}
