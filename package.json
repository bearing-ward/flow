{
  "name": "@flow/workspace",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "research:import": "bun run scripts/import-xyflow.ts",
    "research:inventory": "bun run scripts/inventory-xyflow.ts",
    "research:check-traces": "bun run scripts/check-research-traces.ts",
    "build:packages": "bun run scripts/build-packages.ts",
    "build:vue:packages": "bun run scripts/build-packages.ts vue",
    "test:consumer": "bun run scripts/check-packed-consumer.ts",
    "dev": "bun run build:packages && bun run --cwd apps/vanilla dev",
    "build": "bun run build:packages && bun run --cwd apps/vanilla build",
    "check:architecture": "bun run scripts/check-architecture.ts",
    "docs:generate-api": "bun run scripts/generate-api-reference.ts",
    "docs:check": "bun run scripts/generate-api-reference.ts --check && bun run scripts/check-docs.ts",
    "release:dry-run": "bun run scripts/release-dry-run.ts",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "bun run build:packages && tsc --noEmit",
    "test": "vitest run",
    "test:browser": "bun run build:packages && playwright test",
    "test:conformance:vue": "playwright test -c apps/vue/playwright.config.ts",
    "test:conformance:foldkit": "bun run build:packages && playwright test -c apps/foldkit/playwright.config.ts",
    "test:collector": "bun run scripts/check-collector-delivery.ts",
    "test:collector:stopped": "bun run scripts/check-collector-delivery.ts --stopped-collector",
    "test:foldkit:hmr": "bun run build:foldkit:package && bun run scripts/check-foldkit-hmr.ts",
    "verify": "bun run scripts/verify.ts",
    "verify:full": "bun run scripts/verify.ts --full",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "build:foldkit:package": "bun run scripts/build-packages.ts foldkit"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0",
    "@effect/platform-node-shared": "4.0.0",
    "effect": "4.0.0"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.5",
    "@oxlint/plugins": "1.89.0",
    "@playwright/test": "1.64.1",
    "@types/bun": "1.4.3",
    "@vitest/browser-playwright": "5.0.5",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "typescript": "7.0.2",
    "typescript-api": "npm:typescript@5.9.3",
    "ultracite": "8.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0"
  },
  "hvs": {
    "baseline": "275c2013b54920055db091be00ca29ef096af3b8",
    "profiles": {
      "delivery": "plain-dom-first",
      "tooling": "bun-supported"
    }
  }
}
