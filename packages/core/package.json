{
  "name": "@flow/core",
  "version": "0.0.0",
  "private": true,
  "homepage": "https://bearing-ward.github.io/flow/",
  "files": [
    "dist/public.js",
    "dist/public.d.ts",
    "dist/domain",
    "dist/telemetry",
    "dist/use-cases"
