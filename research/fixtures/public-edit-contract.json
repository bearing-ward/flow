  "queuedDisposal": {
    "version": 1,
    "id": "queued-disposal",
    "description": "A production observer queues a second edit and disposes its host during the first accepted publication. The trigger is accepted, the queued request settles as disposed, and no notification arrives after disposal.",
    "document": {
      "nodes": [
        {
          "id": "right-node",
          "label": "Right node",
          "position": {
            "x": 20,
            "y": 120
          }
        }
      ],
      "edges": []
    },
    "trigger": {
      "operations": [
        {
          "kind": "update-node-data",
          "nodeId": "right-node",
          "data": {
            "count": 1
          }
        }
      ]
    },
    "queued": {
      "operations": [
        {
          "kind": "update-node-data",
          "nodeId": "right-node",
          "data": {
            "count": 2
          }
        }
      ]
    },
    "expected": {
      "triggerOutcome": "accepted",
      "queuedOutcome": "disposed",
      "lateNotifications": 0
    }
  }
