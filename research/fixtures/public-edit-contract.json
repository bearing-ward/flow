{
  "version": 1,
  "fixtures": [
    {
      "version": 1,
      "id": "data-merge-and-replacement",
      "description": "Merge node data and replace edge data in one transaction.",
      "documentMode": "uncontrolled",
      "document": {
        "nodes": [
          {
            "id": "a",
            "label": "A",
            "position": {
              "x": 0,
              "y": 0
            },
            "data": {
              "keep": true,
              "value": 1
            }
          },
          {
            "id": "b",
            "label": "B",
            "position": {
              "x": 200,
              "y": 0
            }
          }
        ],
        "edges": [
          {
            "id": "ab",
            "source": "a",
            "target": "b",
            "data": {
              "old": true,
              "value": 1
            }
          }
        ]
      },
      "transaction": {
        "operations": [
          {
            "kind": "update-node-data",
            "nodeId": "a",
            "data": {
              "value": 2
            }
          },
          {
            "kind": "update-edge-data",
            "edgeId": "ab",
            "data": {
              "value": 3
            },
            "replace": true
          }
        ]
      },
      "expected": {
        "document": {
          "nodes": [
            {
              "id": "a",
              "label": "A",
              "position": {
                "x": 0,
                "y": 0
              },
              "data": {
                "keep": true,
                "value": 2
              }
            },
            {
              "id": "b",
              "label": "B",
              "position": {
                "x": 200,
                "y": 0
              }
            }
          ],
          "edges": [
            {
              "id": "ab",
              "source": "a",
              "target": "b",
              "data": {
                "value": 3
              }
            }
          ]
        },
        "deletedNodeIds": [],
        "deletedEdgeIds": []
      }
    },
    {
