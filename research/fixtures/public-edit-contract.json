            {
              "id": "c",
              "label": "C",
              "position": {
                "x": 200,
                "y": 0
              }
            }
          ],
          "edges": []
        },
        "deletedNodeIds": ["b"],
        "deletedEdgeIds": ["ab", "bc"]
